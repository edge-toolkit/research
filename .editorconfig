root = true

[*]
end_of_line = lf
insert_final_newline = true
indent_size = 2
indent_style = space
max_line_length = 120
trim_trailing_whitespace = true

# Markdown files can have flexible indentation for lists.
[*.md]
indent_size = unset

# PEP 8 indentation, which ruff format writes.
[*.py]
indent_size = 4

# git writes .gitmodules itself, indented with tabs.
[.gitmodules]
indent_style = tab
indent_size = unset
