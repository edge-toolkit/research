{
  "reference-training-outage": {
    "description": "Observe service progress with two clients and verify vessel-3 contributes again after its outage",
    "rounds": 12,
    "minimum_clients": 2,
    "round_timeout_seconds": 30,
    "timeout_seconds": 1800,
    "require_participant_recovery": true,
    "fault": {
      "type": "temporary_scale_down",
      "target": "vessel-3",
      "duration_seconds": 45,
      "trigger": {
        "event_kind": "training-started",
        "workload": "vessel-3",
        "progress": 1
      }
    },
    "model_profile": "pretrained"
  },
  "reference-client-stage-restart": {
    "description": "Seeded selection of training or update-transfer observation before a client restart",
    "rounds": 12,
    "timeout_seconds": 1800,
    "require_participant_recovery": true,
    "fault": {
      "type": "delete_pod",
      "target": "vessel-2",
      "trigger": {
        "choices": [
          {
            "event_kind": "training-started",
            "workload": "vessel-2",
            "progress": 1
          },
          {
            "event_kind": "update-transfer-started",
            "workload": "vessel-2",
            "progress": 1
          }
        ]
      }
    },
    "model_profile": "pretrained"
  },
  "checkpoint-recovery-recent": {
    "description": "Restart after a committed checkpoint and verify unfinished work resumes",
    "rounds": 12,
    "timeout_seconds": 1800,
    "checkpoint_interval": 1,
    "require_recovery": true,
    "require_checkpoint_restore": true,
    "require_unfinished_resume": true,
    "fault": {
      "type": "rollout_restart",
      "target": "vessel-coordinator",
      "trigger": {
        "event_kind": "checkpoint-saved",
        "workload": "vessel-coordinator",
        "progress": 2
      }
    },
    "model_profile": "pretrained"
  },
  "checkpoint-recovery-stale": {
    "description": "Checkpoint every three rounds, interrupt later work and measure retained and repeated progress",
    "rounds": 12,
    "timeout_seconds": 1800,
    "checkpoint_interval": 3,
    "require_recovery": true,
    "require_checkpoint_restore": true,
    "require_unfinished_resume": true,
    "fault": {
