    },
    "model_profile": "pretrained"
  },
  "client-memory-saturation": {
    "description": "Ramp vessel-2 RAM occupancy toward 60%, 75% and 90% of a 768 MiB limit, then verify resumed work",
    "rounds": 12,
    "round_timeout_seconds": 240,
    "timeout_seconds": 1200,
    "require_post_fault_progress": true,
    "recovery_mode": "observe-only",
    "fault": {
      "type": "client_memory_saturation",
      "target": "vessel-2",
      "memory_limit_mib": 768,
      "max_extra_memory_mib": 512,
      "reserve_mib": 64,
      "levels": [
        0.6,
        0.75,
        0.9
      ],
      "hold_seconds": 10,
      "after_round": 0
    },
    "model_profile": "pretrained"
  },
  "client-network-saturation": {
    "description": "Ramp traffic across a controlled 1024 kbit/s client link, release and verify useful progress",
    "rounds": 12,
